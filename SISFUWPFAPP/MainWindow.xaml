<Window x:Name="Window1" x:Class="SISFUWPFAPP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SISFUWPFAPP"
        mc:Ignorable="d"
        Title="Joshua's Desktop Application" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnclick" Content="click" HorizontalAlignment="Left" Margin="10,127,0,0" VerticalAlignment="Top" Height="40" Width="168" Click="Button_Click"/>
        <TextBox x:Name="tb_one" HorizontalAlignment="Left" Margin="10,49,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="317" Height="20"/>
        <Label Content="What is your Name?" HorizontalAlignment="Left" Margin="15,10,0,0" VerticalAlignment="Top" Background="#FF4E5DAF" FontWeight="Bold" Height="34" Width="130"/>
        <Label x:Name="LablWarning" Content="" HorizontalAlignment="Left" Margin="25,74,0,0" VerticalAlignment="Top" Background="#FF921111" FontWeight="Bold" Foreground="White"/>
        <Label Content="PIN" HorizontalAlignment="Left" Margin="25,0,0,0" VerticalAlignment="Center"/>
        <Label x:Name="lblPIN" Content="" HorizontalAlignment="Left" Margin="75,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="-0.235,0.563"/>
        <Button x:Name="buton1" Content="1" HorizontalAlignment="Left" Margin="14,246,0,0" VerticalAlignment="Top" Click="buton1_Click"/>
        <Button x:Name="buton2" Content="2" HorizontalAlignment="Left" Margin="57,246,0,0" VerticalAlignment="Top" Click="buton2_Click" RenderTransformOrigin="-0.259,0.375"/>
        <Button x:Name="buton3" Content="3" HorizontalAlignment="Left" Margin="94,246,0,0" VerticalAlignment="Top" Click="buton3_Click"/>
        <Button x:Name="btn4" Content="4" HorizontalAlignment="Left" Margin="15,279,0,0" VerticalAlignment="Top" Click="btn4_Click"/>
        <Button x:Name="buton4" Content="5" HorizontalAlignment="Left" Margin="57,279,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.366,-0.356" Click="buton4_Click"/>
        <Button x:Name="buton6" Content="6" HorizontalAlignment="Left" Margin="94,279,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.05,-0.034" Click="buton6_Click"/>
        <Button x:Name="buton7" Content="7" HorizontalAlignment="Left" Margin="15,315,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.122,-0.389" Click="buton7_Click"/>
        <Button x:Name="buton8" Content="8" HorizontalAlignment="Left" Margin="57,315,0,0" VerticalAlignment="Top" RenderTransformOrigin="-2.001,2.028" Click="buton8_Click"/>
        <Button x:Name="buton9" Content="9" HorizontalAlignment="Left" Margin="94,315,0,0" VerticalAlignment="Top" Click="buton9_Click"/>
        <Button x:Name="buton0" Content="0" HorizontalAlignment="Left" Margin="54,348,0,0" VerticalAlignment="Top" Click="buton0_Click_1"/>
        <Button x:Name="clearnumb" Content="clear" HorizontalAlignment="Left" Margin="10,348,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.014,-0.277" Click="clearnumb_Click"/>
        <Button x:Name="EnterButton" Content="enter" HorizontalAlignment="Left" Margin="83,353,0,0" VerticalAlignment="Top" Click="EnterButton_Click_1"/>

    </Grid>
</Window>
